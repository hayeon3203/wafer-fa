# daol-fascope 샌드박스 런타임 (LLaVA 모델 서버 전용)
#
# 의도적으로 얇다. 웨이트·venv·코드는 전부 호스트에 남기고
# scripts/start_llava_sandbox.sh 가 원래 절대경로 그대로 bind mount 로 넣는다.
# 이 이미지가 지는 책임은 그 호스트 venv 가 링크하는 OS 공유 라이브러리뿐.
#
# 왜 pip install 이 없나: GB10 은 ARM64 + Blackwell 이라 torch/cu130 휠 재현이
# 비싸고, 재현해봤자 호스트 venv 와 미세하게 달라진다. torch 휠은 CUDA 런타임을
# site-packages/nvidia/* 에 자체 동봉하고 드라이버는 NVIDIA 컨테이너 런타임이
# 호스트에서 넘겨주므로 CUDA 툴킷도 여기 없다. 결과: 빌드가 apt 몇 개다.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# python3   — 호스트의 .venv 가 /usr/bin/python3 를 base 로 잡고 있어 같은 마이너
#             버전이 이미지 안에도 있어야 한다 (Ubuntu 24.04 = 3.12.3, 호스트 동일).
#             `python3.12` 만 깔면 /usr/bin/python3 심볼릭이 안 생겨 venv 의
#             bin/python -> python3 -> /usr/bin/python3 사슬이 끊긴다.
# libgomp1  — torch OpenMP
# gcc / python3-dev — torch 가 첫 generate 때 triton 커널을 JIT 컴파일한다.
#             gcc 가 없으면 "Failed to find C compiler", Python 헤더가 없으면
#             triton 이 만드는 cuda_utils.c 컴파일이 -I/usr/include/python3.12
#             에서 깨진다. 둘 다 기동도 /health 도 멀쩡히 통과하고 **추론에서만**
#             터진다. (DaolVision 런타임엔 이게 없다 — 거기 서비스들은 triton
#             JIT 경로를 안 타서 드러나지 않았을 뿐이다.)
# iproute2 / iptables — openshell supervisor 가 파드 안에서 네트워크 네임스페이스를
#             직접 만든다. 없으면 기동 실패("Network namespace creation failed").
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        libgomp1 \
        gcc \
        python3-dev \
        ca-certificates \
        curl \
        iproute2 \
        iptables \
    && rm -rf /var/lib/apt/lists/*

# openshell supervisor 는 이미지에 'sandbox' 유저/그룹이 있어야 파드를 띄운다
# (없으면 "sandbox user 'sandbox' not found in image").
# uid/gid 는 호스트 admin(1000)에 맞춘다 — 마운트한 웨이트·코드가 uid 1000 소유다.
# ubuntu:24.04 가 1000 을 'ubuntu' 로 선점하고 있어 먼저 지운다.
RUN userdel -r ubuntu 2>/dev/null || true; \
    groupadd -g 1000 sandbox && \
    useradd -u 1000 -g 1000 -m -s /bin/bash sandbox

# openshell 0.0.96 부터 OCI 이미지에 USER 가 없으면 supervisor 가 뜨자마자 죽고
# 재시작 루프를 돈다("OCI USER is required because run_as_user is omitted").
USER sandbox

# openshell 은 파드를 띄울 때 엔트리포인트를 자기 supervisor 로 갈아끼운다.
# 아래 CMD 는 `docker run` 스모크 테스트용 폴백일 뿐이다.
CMD ["sleep", "infinity"]
